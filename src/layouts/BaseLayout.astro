---
/**
 * Общая оболочка всех страниц: <html>, шапка, место под содержимое.
 *
 * Подвал сюда не входит намеренно. Он есть у статических страниц
 * (PageLayout) и полностью отсутствует у эпизодов (EpisodeLayout),
 * чтобы не разрывать поток чтения — ТЗ 4.5.1.
 */

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';

import '@fontsource-variable/onest';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/playfair-display';
// Курсив Playfair подключается отдельно: в основной набор он не входит.
// Нужен потому, что у Onest курсива нет вовсе — браузер наклонял бы буквы
// искусственно. Выделения в тексте отдаём антикве, см. tokens.css.
import '@fontsource-variable/playfair-display/wght-italic.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** Настоящий адрес страницы, если открыли её другим. */
  canonicalPath?: string;
}

/*
 * Высоту шапки точно измерит chrome.js, но до его запуска страница уже
 * отрисована — и если начальное значение не угадано, содержимое прыгнет.
 * Сервер знает, будет ли вторая строка с плашкой серии, поэтому начальное
 * приближение задаём здесь: скачок вёрстки сводится к нулю.
 */
const chromeHeight = Astro.slots.has('plate') ? '7.25rem' : '4.5rem';
---

<html lang="ru" style={`--chrome-height:${chromeHeight}`}>
  <head>
    <BaseHead {...Astro.props} />
    {/* Структурные данные приходят слотом: их состав зависит от того, что
        за страница, а `BaseLayout` этого не знает и знать не должен. */}
    <slot name="schema" />
  </head>

  <body>
    <a class="skip-to-main" href="#main">Перейти к содержанию</a>

    <Header>
      <slot name="plate" slot="plate" />
    </Header>

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />

    <script>
      import { startChrome, startDrawer } from '../scripts/chrome.js';
      import { startReveal } from '../scripts/reveal.js';
      import { startReader } from '../scripts/reader.js';

      startChrome();
      startDrawer();
      startReveal();
      startReader();   // сам ничего не делает, если на странице нет потока глав

      document.getElementById('themeToggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
      });
    </script>

    <style is:global>
      /*
        Отступ под фиксированной шапкой. Точную высоту измеряет chrome.js и
        уточняет в --chrome-height: плашка серии бывает и в две строки при
        длинном названии сериала. Начальное приближение проставлено сервером
        на <html> — иначе содержимое прыгало бы в момент запуска скрипта.
      */
      body { padding-top: var(--chrome-height, 4.5rem); }
    </style>
  </body>
</html>
