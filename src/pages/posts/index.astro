---
/**
 * «Все статьи» — указатель по всему сайту, пункт меню «03: все статьи».
 *
 * ЗАЧЕМ ОТДЕЛЬНАЯ СТРАНИЦА, А НЕ ЖУРНАЛ. Соблазн был завести журнал
 * «Все статьи» рядом с остальными: данные те же, место на витрине есть.
 * Но журнал в этом проекте — авторская вещь: у него есть «о чём он»,
 * он попадает в блок «эта статья также входит в», в полку «другие журналы»
 * и в `llms.txt` как сюжет. Журнал, куда входит всё, во всех этих местах
 * сообщал бы ровно ноль — и при этом требовал бы дописывать членство
 * в каждую новую статью руками, всегда.
 *
 * Указатель не требует ничего: он собирается из того, что уже есть,
 * и новая статья попадает сюда в ту же секунду, что и в ленту «свежее».
 *
 * ПОРЯДОК — ОТ ПЕРВОЙ СТАТЬИ К ПОСЛЕДНЕЙ, обратно ленте «свежее».
 *
 * У двух списков разные читатели. Постоянному нужно «что нового» — для него
 * витрина и RSS. Новому нужно «с чего начать», и такого входа на сайте
 * не было вовсе. Три минуты, которые он готов потратить, начинаются здесь,
 * с первой статьи.
 *
 * Считается порядок по дате появления НА САЙТЕ, а не по дате первой
 * публикации. Для архивных текстов это разные вещи: внутри журнала они стоят
 * своей исторической чередой (`origin.date`), здесь — днём переноса.
 * Год оригинала виден в строке отдельной пометкой, иначе он потерялся бы.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedPosts, getPublishedSeries, canonicalHref } from '../../lib/content';

// getPublishedPosts отдаёт новые сверху — здесь нужен обратный порядок.
const posts = [...(await getPublishedPosts())].reverse();
const series = await getPublishedSeries();

const titleOf = new Map(series.map((s) => [s.data.id, s.data]));

/** Год появления — заголовок группы. Годы тоже идут от ранних к поздним. */
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))].sort((a, b) => a - b);

const day = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });
---

<BaseLayout
  title="Все статьи"
  description="Полный указатель статей сайта по датам появления: заголовок, журналы, год первой публикации для архивных текстов."
>
  <div class="container">
    <header class="head">
      <p class="mono index">03 / все статьи</p>
      <h1>Все статьи</h1>
      <p class="lead text">
        Всё, что есть на сайте, от первой статьи к последней. Если текст
        выходил когда-то раньше на другой площадке, рядом стоит год первой
        публикации.
      </p>
      <p class="lead text hint">
        Статья открывается в своём журнале и дальше идёт подряд — по нему,
        а не по всему сайту. Журналы каждой статьи перечислены в строке;
        первый из них и ведёт чтение.
      </p>
    </header>

    {posts.length === 0 && <p class="empty">Пока ни одной статьи.</p>}

    {years.map((year) => (
      <section class="year">
        <h2 class="mono stamp">{year}</h2>
        <ul class="list">
          {posts
            .filter((p) => p.data.date.getFullYear() === year)
            .map((post) => (
              <li>
                <a class="row" href={canonicalHref(post)}>
                  <span class="mono when">{day(post.data.date)}</span>
                  <span class="body">
                    <span class="title">{post.data.title}</span>
                    <span class="about">{post.data.description}</span>
                    <span class="mono marks">
                      {post.data.series.map((id) => {
                        const s = titleOf.get(id);
                        return s ? <span class="mark">{s.icon} {s.title}</span> : null;
                      })}
                      {post.data.origin && (
                        <span class="mark mark--archive">
                          впервые {post.data.origin.date.getFullYear()}
                        </span>
                      )}
                    </span>
                  </span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))}

    <p class="onward">
      <a href="/series" class="link--right">Перейти к журналам на столике <span>→</span></a>
    </p>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .head { padding-top: clamp(2rem, 8vw, 5rem); max-width: 40rem; }
  .index { opacity: var(--dim); margin-bottom: 1rem; }
  .lead { margin-top: 1rem; font-size: var(--fs-lg); line-height: 1.6; opacity: .8; }

  /* Пояснение о том, куда ведёт клик, — тише основного текста: оно нужно
     один раз, при первом заходе, и не должно спорить с описанием. */
  .hint { font-size: var(--fs-base); opacity: var(--dim); }
  .empty { opacity: var(--dim); margin-top: 2rem; }

  .year { margin-top: clamp(2.5rem, 7vw, 4rem); }

  /* Год держится у края, а не плывёт над списком: взгляд цепляется
     за одну вертикаль и при длинном списке не теряет, где какой год. */
  .stamp {
    font-size: var(--fs-sm);
    opacity: var(--dim);
    padding-bottom: .5rem;
    border-bottom: 1px solid;
    border-color: color-mix(in srgb, currentColor 18%, transparent);
  }

  .list { list-style: none; padding: 0; margin: 0; }
  .list li + li { border-top: 1px solid; border-color: color-mix(in srgb, currentColor 10%, transparent); }

  .row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    color: inherit;
    text-decoration: none;
  }
  .row:hover .title { color: var(--accent); }

  .when { opacity: var(--dim); font-size: var(--fs-xs); padding-top: .25em; }

  .body { display: block; max-width: 44rem; }
  .title { display: block; font-size: var(--fs-lg); font-weight: var(--bold); line-height: 1.3; }
  .about { display: block; margin-top: .35rem; line-height: 1.55; opacity: .75; }

  .marks { display: flex; flex-wrap: wrap; gap: .4rem .9rem; margin-top: .5rem; }
  .mark { font-size: var(--fs-xs); opacity: var(--dim); white-space: nowrap; }
  .mark--archive { color: var(--accent); opacity: .9; }

  .onward { margin-top: clamp(3rem, 8vw, 5rem); }
  .onward a { color: var(--accent); text-decoration: none; }

  /* На телефоне дата уходит над заголовком: восемь сантиметров под колонку
     дат оставили бы заголовку половину экрана. */
  @media (max-width: 34rem) {
    .row { grid-template-columns: 1fr; gap: .25rem; }
    .when { padding-top: 0; }
  }
</style>
