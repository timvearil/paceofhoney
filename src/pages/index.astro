---
/**
 * Витрина проекта.
 *
 * Порядок экрана задан ТЗ 2.2: главный кадр с когнитивным паспортом,
 * затем сериалы, затем свежие материалы, затем подвал с цоколем.
 *
 * Все блоки переживают пустоту: пока серий и статей нет, витрина остаётся
 * осмысленной страницей, а не решетом из заглушек.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Frame from '../components/Frame.astro';
import SeriesCard from '../components/SeriesCard.astro';
import PostCard from '../components/PostCard.astro';
import { getEntry, render } from 'astro:content';
import { getPublishedSeries, getPublishedPosts, getSeriesCards } from '../lib/content';

const passportEntry = await getEntry('passport', 'passport');
const passport = passportEntry?.data;
const Passport = passportEntry ? (await render(passportEntry)).Content : null;

const series = await getPublishedSeries();
// Карточка ведёт сразу в чтение, поэтому ей нужен адрес первой главы нити.
const cards = await getSeriesCards();

// Свежее — строго по календарной дате от новых к старым (ТЗ 4.3.3).
const posts = await getPublishedPosts();
const latest = posts.slice(0, 6);

// Подписи серий для ленты: там контекста нет, и читателю полезно видеть,
// из какого сюжета материал.
const titleOf = new Map(series.map((s) => [s.data.id, s.data.title]));
---

<BaseLayout
  title="Со скоростью мёда"
  description="Суверенный медиапроект о выходе из цифровой «Карусели»."
  image={passport?.hero_image?.src}
>
  <div class="container">
    <header class="hero">
      <h1 class="mark">Со скоростью мёда<span class="dot">.</span></h1>

      {Passport && (
        <div class="passport text">
          <Passport />
        </div>
      )}
    </header>

    {passport?.hero_image && (
      <section class="section shot">
        <Frame
          src={passport.hero_image}
          alt={passport.hero_alt ?? ''}
          caption={passport.hero_caption}
          ratio="16 / 9"
          eager
        />
      </section>
    )}

    {/*
      Свежее стоит выше сериалов намеренно.

      Вернувшийся читатель приходит за новым — и если сначала встречает
      витрину серий, ему нужно её пролистать, чтобы понять, появилось ли
      что-нибудь с прошлого раза. Серии никуда не денутся: они ниже и
      продублированы в меню, а новая статья живёт в ленте один раз.
    */}
    {latest.length > 0 && (
      <section class="section section--lg" aria-labelledby="latest-head">
        <p class="mono index">02 / свежее</p>
        <h2 id="latest-head" class="sr-only">Свежие материалы</h2>

        <div class="feed">
          {latest.map((p) => (
            <PostCard
              post={p}
              badges={p.data.series.map((id) => titleOf.get(id)).filter(Boolean) as string[]}
            />
          ))}
        </div>

        {posts.length > latest.length && (
          <p class="more">
            <a href="/series" class="link--right">Все сюжеты <span>→</span></a>
          </p>
        )}
      </section>
    )}

    <section class="section section--lg" aria-labelledby="series-head">
      <p class="mono index">03 / сериалы и сюжеты</p>
      <h2 id="series-head" class="sr-only">Сериалы и сюжеты</h2>

      {cards.length > 0 ? (
        <div class="grid">
          {cards.map((c) => (
            <SeriesCard
              id={c.data.id} title={c.data.title} description={c.data.description}
              icon={c.data.icon} cover={c.data.cover_image} coverAlt={c.data.cover_alt}
              episodes={c.episodes} readHref={c.readHref}
            />
          ))}
        </div>
      ) : (
        <p class="empty">Первые сериалы готовятся к выходу.</p>
      )}
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .hero { padding-top: clamp(2rem, 8vw, 5rem); }
  .mark { max-width: 14ch; }
  .dot { color: var(--accent); }

  .passport {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 38rem;
    font-size: var(--fs-lg);
    line-height: 1.6;
  }
  .passport :global(p:not(:last-child)) { margin-bottom: .75em; }

  .shot { margin-top: clamp(2.5rem, 7vw, 4.5rem); }

  .index { opacity: .45; margin-bottom: 1.5rem; }

  .grid {
    display: grid; gap: 2.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  .feed { border-bottom: 1px solid; border-color: color-mix(in srgb, currentColor 18%, transparent); }

  .empty { opacity: .5; max-width: 34rem; }

  .more { margin-top: 1.5rem; }
  .more a { color: var(--accent); text-decoration: none; }
  .more a span { display: inline-block; transition: padding-left var(--t-fast); }
  .more a:hover span { padding-left: .5rem; }
</style>
