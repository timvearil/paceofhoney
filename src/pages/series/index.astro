---
/**
 * Каталог подборок — пункт меню «02: серии».
 *
 * Сортировка по полю `order` из файла серии, а не по алфавиту: порядок
 * на витрине — редакторское решение, а не случайность.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { getSeriesCards } from '../../lib/content';

// Карточка ведёт сразу в чтение, поэтому ей нужен адрес первой главы нити.
const cards = await getSeriesCards();

const serials = cards.filter((c) => c.data.kind === 'serial');
const collections = cards.filter((c) => c.data.kind === 'collection');
---

<BaseLayout
  title="Журналы"
  description="Все журналы проекта: сквозные сюжеты, которые читаются подряд, и тематические — без общей линии."
>
  <div class="container catalogue">
    <header class="head">
      <p class="mono index">02 / журналы</p>
      <h1>Журналы на столике</h1>
      <p class="lead text">
        Каждый журнал читается подряд, как книга. Одна статья может входить
        сразу в несколько журналов — и в каждом у неё свой номер.
      </p>
    </header>

    {cards.length === 0 && (
      <p class="empty">Первые журналы готовятся к выходу.</p>
    )}

    {serials.length > 0 && (
      <section class="section section--lg">
        <div class="grid">
          {serials.map((c) => (
            <SeriesCard
              id={c.data.id} title={c.data.title} description={c.data.description}
              icon={c.data.icon} cover={c.data.cover_image} coverAlt={c.data.cover_alt}
              coverPosition={c.data.cover_position}
              episodes={c.episodes} readHref={c.readHref}
            />
          ))}
        </div>
      </section>
    )}

    {collections.length > 0 && (
      <section class="section section--lg">
        <p class="mono index">без сквозного сюжета</p>
        <div class="grid">
          {collections.map((c) => (
            <SeriesCard
              id={c.data.id} title={c.data.title} description={c.data.description}
              icon={c.data.icon} cover={c.data.cover_image} coverAlt={c.data.cover_alt}
              coverPosition={c.data.cover_position}
              episodes={c.episodes} readHref={c.readHref}
            />
          ))}
        </div>
      </section>
    )}
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .catalogue { padding-top: clamp(2rem, 6vw, 4rem); }
  .index { opacity: var(--dim); margin-bottom: 1rem; }
  .lead { margin-top: 1.25rem; max-width: 38rem; line-height: 1.6; opacity: .75; }
  .empty { margin-top: 2rem; opacity: var(--dim); }
  .grid {
    display: grid; gap: 2.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
</style>
