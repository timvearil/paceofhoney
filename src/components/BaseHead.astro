---
/**
 * Содержимое <head>: мета, разметка для соцсетей, иконки, выбор темы.
 *
 * Спецификация: 01_Spec/tz-paceofhoney-v2.md, раздел 3.3.4
 */

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /**
   * Настоящий адрес страницы, если он отличается от того, по которому её
   * открыли. Глава доступна несколькими адресами — по одному на серию,
   * в которую входит, — но текст один, и поисковику показываем один.
   */
  canonicalPath?: string;
}

const {
  title,
  description,
  image = '/images/og-default.jpg',
  type = 'website',
  publishedAt,
  updatedAt,
  canonicalPath,
} = Astro.props;

const SITE_NAME = 'Со скоростью мёда';

// Канонический адрес и картинка — абсолютными URL. Мессенджеры относительные
// пути не разбирают и показывают превью без картинки.
//
// Расширение из адреса убирается: файлы собираются как `about.html`, но
// публичный адрес страницы — `/about`. Если оставить как есть, поисковик
// сочтёт настоящим адресом тот, что с расширением, и в выдачу пойдёт он.
const cleanPath =
  canonicalPath ?? Astro.url.pathname.replace(/\.html$/, '').replace(/^\/index$/, '/');
const canonical = new URL(cleanPath, Astro.site);
const imageUrl = new URL(image, Astro.site);
const fullTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#F9FAFB" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="ru_RU" />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />

{/*
  Выбор темы до первой отрисовки. Скрипт блокирующий и намеренно крошечный:
  без него читатель в тёмной теме получает вспышку белого на каждой странице.
*/}
<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem('theme');
      if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      if (t === 'dark') document.documentElement.classList.add('dark');
    } catch (e) { /* приватный режим — остаёмся в светлой теме */ }
  })();
</script>
