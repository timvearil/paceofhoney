---
/**
 * Структурные данные JSON-LD.
 *
 * То, что читает машина, когда ей мало текста: поисковик, агрегатор, модель
 * с поиском. Разметка описывает сайт, авторов, серию и статью одним графом,
 * связанным через `@id` — так разбирающая сторона понимает, что `Article`
 * принадлежит той же `Blog`, что и остальные.
 *
 * АРХИВНЫЕ СТАТЬИ — главное здесь.
 *
 *   datePublished — дата **первой** публикации, где бы она ни была;
 *   dateModified  — когда текст появился здесь или правился;
 *   isBasedOn     — ссылка на снимок в веб-архиве либо на оригинал.
 *
 * Пара «datePublished 2011 + isBasedOn на снимок 2012 года» — единственное
 * машинно проверяемое утверждение о том, что текст написан до эпохи
 * генеративных моделей. Сказать это словами может кто угодно; сослаться
 * на чужой датированный снимок — нет (ТЗ 0.11, 0.12).
 */

import type { Post, Series, Thread } from '../lib/content';
import { CORPUS_ID, mentionedTerms } from '../lib/content';
import { getEntry } from 'astro:content';

interface Props {
  /** Страница главы: статья и нить, которой её читают. */
  post?: Post;
  thread?: Thread;
  /** Страница серии. */
  series?: Series;
  /** Витрина. */
  home?: boolean;
  /**
   * Словарь: список «термин — определение».
   *
   * Названное понятие делает сайт первоисточником, и `DefinedTermSet` —
   * тот язык, на котором это можно сказать машине прямо: вот набор терминов,
   * вот определения, вот кто их дал. Для трёх наших понятий это правда;
   * для четырёх чужих в определении сказано, что слово не наше, — врать
   * разметкой было бы худшим способом соврать, потому что её читают
   * не глядя.
   */
  terms?: { name: string; description: string }[];

  /**
   * Статическая страница: «О нас», словарь и всё, что придёт после.
   *
   * До 29.09 у них не было разметки вовсе — ни типа, ни автора, ни связи
   * с сайтом. Для страниц, куда агент идёт за ответом «кто это и чему тут
   * верить», странно молчать именно там.
   */
  page?: {
    title: string;
    description: string;
    about?: boolean;
    /** Ведущий кадр страницы — на тех же правах, что кадр статьи. */
    image?: { src: string };
    alt?: string;
    credit?: string;
    date?: Date;
  };
  canonical: string;
}

const { post, thread, series, home = false, terms, page, canonical } = Astro.props;

const SITE = 'https://paceofhoney.me';
const NAME = 'Со скоростью мёда';

/*
 * Права — машиночитаемо.
 *
 * «Цитировать можно со ссылкой на источник» написано человеческим языком
 * в `robots.txt` и в `llms.txt`, и человек это поймёт. Модель, решающая,
 * можно ли цитировать, читает разметку — а там об этом не было сказано
 * ничего. Разница между «вроде можно» и «сказано, что можно».
 *
 * Полноценной лицензии вроде Creative Commons здесь нет намеренно: она
 * задала бы условия, которых Тимур не выбирал. Сказано ровно то, что есть:
 * доступ бесплатный, автор известен, цитирование со ссылкой разрешено.
 */
const RIGHTS = {
  isAccessibleForFree: true,
  usageInfo: `${SITE}/about`,
  copyrightHolder: { '@id': `${SITE}/#tim` },
  copyrightYear: 2026,
};

/*
 * Внешние профили — `sameAs`, замыкание графа.
 *
 * Без этого авторы в разметке были людьми без единой внешней привязки,
 * а домен — сайтом без истории: разбирающая сторона не могла связать
 * `paceofhoney.me` ни с каналами, ни с архивом на Blogger и ski.ru.
 *
 * Два набора, и путать их нельзя: канал проекта — не человек, человек —
 * не канал. Blogger отнесён к Тимуру намеренно: это другой блог с другим
 * названием, предшественник, а не та же вещь.
 *
 * `sameAs` живёт только в разметке. Читатель её не видит и никуда по ней
 * не уходит, поэтому решение не отправлять его на чужие площадки остаётся
 * в силе.
 *
 * Список сверен 29.09.2026, каждая ссылка открыта и опознана. Перепроверять
 * раз в полгода: мёртвая ссылка здесь хуже отсутствующей — её проверят
 * и перестанут верить остальным. Полный справочник с пояснениями —
 * `00_Reference/profili-i-ploshchadki.md`.
 */
const PROJECT_PROFILES = [
  'https://dzen.ru/pace_of_honey',
  'https://vk.ru/pace_of_honey',
  'https://vk.ru/honey_stories',
  'https://t.me/pace_of_honey',
  'https://max.ru/channel_pace_of_honey',
  'https://www.youtube.com/@pace_of_honey',
  'https://vkvideo.ru/@pace_of_honey',
];

const TIM_PROFILES = [
  'https://www.ski.ru/az/blogs/user/T1ms/',
  'https://timvearil.blogspot.com',
  'https://www.facebook.com/Timvearil',
  'https://www.instagram.com/timvearil',
  'https://vk.ru/timur_1972',
];

const VENERA_PROFILES = ['https://vk.ru/v.abzalilova'];

/*
 * ФОТОГРАФИЯ КАК ОБЪЕКТ, А НЕ КАК АДРЕС ФАЙЛА.
 *
 * До 01.10 от ведущего кадра в графе жила одна строка — ссылка на картинку.
 * Для машины это значило ровно ничего: файл есть, кто его снял и на каких
 * условиях его можно брать — неизвестно.
 *
 * Естественным местом для этих сведений кажется EXIF — те самые данные
 * камеры, выдержки и места съёмки. Проверено замером: до сайта не доезжает
 * ни одного поля. Метаданные срезает первое же пересжатие в `sync-images`,
 * а остатки — нарезка srcset в самом Astro; вернуть их настройкой нельзя,
 * потому что срезы Astro делает сам. И это к лучшему по двум причинам:
 * в EXIF лежат координаты дома и пасеки, а доказательством авторства он
 * всё равно не служит — его дописывает любой редактор за два клика.
 *
 * Поэтому происхождение кадра говорится здесь, явно: автор — ссылкой
 * на `Person`, у которого в графе тринадцать внешних профилей; лицензия —
 * из настроек подвала; описание — из `lead_alt`, который схема требует
 * у каждого кадра; дата — дата статьи.
 *
 * Исключения (`lead_credit`) ломают это по умолчанию намеренно: кадр
 * с дорисовкой не записывается на нас, а чужой кадр не передаёт нам прав
 * на него. Соврать разметкой — худший способ соврать: её читают не глядя.
 */
const AI_CREDIT = /^ai$/i;

function imageObject(
  image: { src: string } | undefined,
  opts: { alt?: string; credit?: string; date?: Date; license?: string },
) {
  if (!image?.src) return undefined;

  const node: Record<string, unknown> = {
    '@type': 'ImageObject',
    contentUrl: new URL(image.src, SITE).href,
  };
  if (opts.alt) node.description = opts.alt;
  if (opts.date) node.dateCreated = opts.date.toISOString().slice(0, 10);

  if (!opts.credit) {
    // Обычный случай: сняли сами.
    node.creator = { '@id': `${SITE}/#tim` };
    node.copyrightHolder = { '@id': `${SITE}/#tim` };
    if (opts.license) node.license = opts.license;
  } else if (AI_CREDIT.test(opts.credit)) {
    // В кадре дорисованы детали. Автором ставить человека нельзя,
    // а лицензию объявлять не на что: прав на машинную работу у нас нет.
    node.creditText = 'Детали кадра дорисованы генеративной моделью';
  } else {
    // Снимал кто-то другой: имя как есть, права остаются при нём.
    node.creator = { '@type': 'Person', name: opts.credit };
    node.creditText = opts.credit;
  }
  return node;
}

/* Лицензия на фотографии — из настроек подвала, одной строкой на весь сайт. */
const PHOTO_LICENSE = (await getEntry('footer', 'footer'))?.data.photo_license;

/* Авторы — двое, и они постоянны: объявляем один раз, ссылаемся по `@id`. */
const authors = [
  {
    '@type': 'Person',
    '@id': `${SITE}/#tim`,
    name: 'Тимур',
    url: `${SITE}/about`,
    sameAs: TIM_PROFILES,
  },
  {
    '@type': 'Person',
    '@id': `${SITE}/#venera`,
    name: 'Венера',
    url: `${SITE}/about`,
    sameAs: VENERA_PROFILES,
  },
];

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE}/#website`,
    url: `${SITE}/`,
    name: NAME,
    inLanguage: 'ru-RU',
    description:
      'Журнал о выходе из цифровой «Карусели»: пчеловодство, кибербезопасность ' +
      'через жизнь улья, финансовые аферы через приключения трутней.',
    publisher: { '@id': `${SITE}/#tim` },
    sameAs: PROJECT_PROFILES,
    ...RIGHTS,
  },
  ...authors,
  {
    '@type': 'Blog',
    '@id': `${SITE}/#blog`,
    url: `${SITE}/`,
    name: NAME,
    inLanguage: 'ru-RU',
    isPartOf: { '@id': `${SITE}/#website` },
    author: authors.map((a) => ({ '@id': a['@id'] })),
  },
];

/*
 * Серия попадает в граф и со своей страницы, и со страницы главы.
 *
 * Второе не для красоты: статья ссылается на серию по `@id`, и если самого
 * объекта в графе нет, ссылка висит в пустоту. Разбирающая сторона в лучшем
 * случае её проигнорирует, в худшем сочтёт разметку битой.
 */
/*
 * Сквозная нить в графе не существует — и не должна.
 *
 * Читателю она журнал заменяет, но журналом не является: файла у неё нет,
 * страницы `/series/all` нет, на витрине её нет. Разметка, объявившая её
 * `CreativeWorkSeries`, утверждала бы, что такой журнал есть, и давала
 * ссылку в пустоту — а это худший вид ошибки в разметке: проверяемый.
 * Нашлось при проверке готовности к агентам 29.09, на двадцати страницах.
 *
 * Сама статья от этого не беднеет: её принадлежность журналам уже описана
 * ведущей нитью на каноническом адресе.
 */
const described = (series ?? thread?.series)?.data.id === CORPUS_ID
  ? undefined
  : series ?? thread?.series;

if (described) {
  graph.push({
    '@type': 'CreativeWorkSeries',
    '@id': `${SITE}/series/${described.data.id}#series`,
    url: `${SITE}/series/${described.data.id}`,
    name: described.data.title,
    description: described.data.description,
    inLanguage: 'ru-RU',
    isPartOf: { '@id': `${SITE}/#blog` },
  });
}

if (post) {
  const d = post.data;
  const o = d.origin;

  /*
   * Архивной статье первой публикацией считается её настоящая первая
   * публикация, а не перенос сюда. Иначе разметка утверждала бы, что текст
   * 2011 года написан в 2026-м — и пропадало бы единственное, ради чего
   * весь блок затевался.
   */
  const article: Record<string, unknown> = {
    '@type': 'Article',
    '@id': `${SITE}/posts/${d.slug}#article`,
    url: `${SITE}/posts/${d.slug}`,
    mainEntityOfPage: `${SITE}/posts/${d.slug}`,
    headline: d.title,
    description: d.description,
    inLanguage: 'ru-RU',
    datePublished: (o?.date ?? d.date).toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    author: authors.map((a) => ({ '@id': a['@id'] })),
    publisher: { '@id': `${SITE}/#tim` },
    isPartOf: { '@id': `${SITE}/#blog` },
    ...RIGHTS,
  };

  if (d.tags?.length) article.keywords = d.tags.join(', ');

  /*
   * Понятия, которые статья употребляет, — ссылкой на словарь.
   *
   * Так связь «текст ↔ понятие» становится видна машине: спросив о термине,
   * она найдёт не только определение, но и тексты, где он живёт. Это и есть
   * разница между «мы придумали слово» и «мы им пользуемся».
   */
  const mentions = await mentionedTerms(post);
  if (mentions.length) {
    article.mentions = mentions.map((name) => ({
      '@type': 'DefinedTerm',
      '@id': `${SITE}/slovar#${encodeURIComponent(name.toLowerCase())}`,
      name,
      inDefinedTermSet: { '@id': `${SITE}/slovar#terms` },
    }));
  }
  const image = imageObject(d.lead_image, {
    alt: d.lead_alt,
    credit: d.lead_credit,
    date: d.origin?.date ?? d.date,
    license: PHOTO_LICENSE,
  });
  if (image) article.image = image;

  // Место статьи в журнале — только для настоящих журналов: у сквозной нити
  // номер есть, но ссылаться ему не на что (см. `described` выше).
  if (thread && thread.series.data.id !== CORPUS_ID) {
    article.isPartOf = [
      { '@id': `${SITE}/#blog` },
      { '@id': `${SITE}/series/${thread.series.data.id}#series` },
    ];
    article.position = thread.number;
  }

  // Ссылка на первоисточник: сначала снимок — он датирован и переживёт
  // площадку, — и только потом живая ссылка.
  if (o?.archive || o?.url) {
    article.isBasedOn = [o.archive, o.url].filter(Boolean);
  }

  graph.push(article);
}

if (home) {
  graph.push({
    '@type': 'CollectionPage',
    '@id': `${SITE}/#home`,
    url: `${SITE}/`,
    name: NAME,
    isPartOf: { '@id': `${SITE}/#website` },
  });
}

if (page) {
  const pageImage = imageObject(page.image, {
    alt: page.alt,
    credit: page.credit,
    date: page.date,
    license: PHOTO_LICENSE,
  });
  graph.push({
    // `AboutPage` — для страницы о самих авторах; остальным хватает `WebPage`.
    '@type': page.about ? 'AboutPage' : 'WebPage',
    '@id': `${SITE}${canonical}#page`,
    url: `${SITE}${canonical}`,
    name: page.title,
    description: page.description,
    inLanguage: 'ru-RU',
    isPartOf: { '@id': `${SITE}/#website` },
    author: authors.map((a) => ({ '@id': a['@id'] })),
    ...(pageImage ? { image: pageImage } : {}),
    ...RIGHTS,
  });
}

if (terms?.length) {
  const setId = `${SITE}${canonical}#terms`;
  graph.push({
    '@type': 'DefinedTermSet',
    '@id': setId,
    name: `Словарь проекта «${NAME}»`,
    url: `${SITE}${canonical}`,
    inLanguage: 'ru-RU',
    hasDefinedTerm: terms.map((t) => ({
      '@type': 'DefinedTerm',
      '@id': `${SITE}${canonical}#${encodeURIComponent(t.name.toLowerCase())}`,
      name: t.name,
      description: t.description,
      inDefinedTermSet: { '@id': setId },
    })),
  });
}

const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<script type="application/ld+json" set:html={json} />
