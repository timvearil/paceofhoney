---
/**
 * Карточка сериала для витрины и каталога подборок.
 *
 * Заголовок вынесен над кадром и свисает за его верхнюю кромку — приём канона.
 * При наведении карточка подтягивается, кнопка выезжает снизу, кадр наливается
 * цветом через общий механизм Frame.
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  description: string;
  icon: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  /** Куда смотреть при обрезке — см. `cover_position` в файле серии. */
  coverPosition?: string;
  episodes?: number;
  /**
   * Адрес первой главы этой нити. Карточка ведёт сразу в чтение, а не
   * в оглавление. Считает его вызывающий — он знает, о какой серии речь.
   */
  readHref?: string;
}

const { id, title, description, icon, cover, coverAlt, coverPosition = 'center', episodes, readHref } =
  Astro.props;

/*
 * Карточка открывает чтение, а не оглавление.
 *
 * Раньше она вела на страницу серии, хотя кнопка обещала «открыть с 1-й главы».
 * Получалось три клика от меню до текста и обещание, которого интерфейс не
 * выполнял. Страница серии нужна для другого — выбрать произвольную главу,
 * и ссылка на неё стоит отдельно, ниже.
 *
 * Пустая серия — исключение: вести некуда, открываем оглавление.
 */
/*
 * Адрес называет серию, потому что от неё зависит всё дальнейшее чтение:
 * номер главы, что подъедет следующим, чем кончится нить. Нажал «Ироничная
 * пасека» — читаешь её, а не ту серию, которая у статьи записана первой.
 */
const to = readHref ?? `/series/${id}`;

/*
 * Тёплый свет ставится и пустому месту, где кадра ещё нет.
 *
 * На ровном фоне он виден лучше, чем на фотографии: глаз ловит форму пятна,
 * а не его силу. Заодно пустая карточка показывает, что кадр здесь будет.
 * Признак `data-focus-frame` стоит поэтому у обеих веток — и у снимка,
 * и у заглушки.
 */
---

<article class="card" data-fade-up>
  <a class="link" href={to}>
    <div class="head">
      <h2 class="h3 title">
        <span class="icon" aria-hidden="true">{icon}</span>{title}
      </h2>
      <p class="cta mono">
        {readHref ? 'открыть с 1-й статьи →' : 'смотреть серию →'}
      </p>
    </div>

    {cover ? (
      <div class="shot" data-focus-frame>
        <Image src={cover} alt={coverAlt ?? ''} widths={[480, 768, 1024]}
               sizes="(min-width: 64rem) 22rem, 90vw" loading="lazy"
               style={`object-position:${coverPosition}`} />
      </div>
    ) : (
      <div class="shot shot--empty" data-focus-frame aria-hidden="true">
        <span class="mono">кадр не выбран</span>
      </div>
    )}

    <p class="desc">{description}</p>
  </a>

  {/*
    Вторая ссылка — вне карточки-ссылки: вложенные ссылки в разметке
    запрещены, а читателю нужны оба маршрута. Основной ведёт в чтение,
    этот — в оглавление, откуда можно выбрать любую главу.
  */}
  <p class="foot mono">
    {episodes !== undefined && (
      <span class="count">{episodes} {episodes === 1 ? 'статья' : episodes < 5 ? 'статьи' : 'статей'}</span>
    )}
    {readHref && <a class="toc" href={`/series/${id}`}>все статьи</a>}
  </p>
</article>

<style>
  .card { position: relative; }
  .link { display: block; color: inherit; text-decoration: none; }

  .head { margin-bottom: .75rem; }
  .title { margin: 0; display: flex; align-items: baseline; gap: .5rem; }
  .icon { font-size: .8em; }

  .cta {
    margin-top: .4rem;
    color: var(--accent);
    opacity: 0; transform: translateY(.4rem);
    transition: opacity var(--t-fast), transform var(--t-fast);
  }

  /* Только геометрия. Проявление цвета и тёплый свет — общие правила
     [data-focus-frame] в tokens.css. */
  .shot {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
  }
  .shot :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover;
  }

  .shot--empty {
    display: grid; place-items: center;
    border: 1px dashed currentColor; opacity: .3;
  }

  .desc { margin-top: .75rem; line-height: 1.5; font-size: var(--fs-sm); opacity: .75; }

  .foot { display: flex; flex-wrap: wrap; gap: .4rem 1rem; margin-top: .5rem; }
  .count { opacity: var(--dim); }
  .toc { color: var(--accent); text-decoration: none; }
  .toc:hover { text-decoration: underline; text-underline-offset: .2em; }

  /* Здесь фокусом считается наведение на всю карточку, а не только на кадр:
     читатель ведёт мышь к заголовку, а оживать должна карточка целиком.
     Поэтому правило своё, а не общее. */
  @media (hover: hover) and (pointer: fine) {
    .link:hover .cta { opacity: 1; transform: translateY(0); }
    .link:hover .shot :global(img) {
      filter: var(--frame-warm); opacity: 1; transform: scale(1.02);
    }
    .link:hover .shot::before,
    .link:hover .shot::after { opacity: 1; }
  }

  /* Появление карточек при прокрутке. */
  .card[data-fade-up] { opacity: 0; transform: translateY(2rem);
    transition: opacity 1s ease, transform 1s ease; }
  .card[data-fade-up].fade-up { opacity: 1; transform: translateY(0); }
</style>
