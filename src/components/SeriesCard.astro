---
/**
 * Карточка сериала для витрины и каталога подборок.
 *
 * Заголовок вынесен над кадром и свисает за его верхнюю кромку — приём канона.
 * При наведении карточка подтягивается, кнопка выезжает снизу, кадр наливается
 * цветом через общий механизм Frame.
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  description: string;
  icon: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  episodes?: number;
}

const { id, title, description, icon, cover, coverAlt, episodes } = Astro.props;
---

<article class="card" data-fade-up>
  <a class="link" href={`/series/${id}`}>
    <div class="head">
      <h3 class="h3 title">
        <span class="icon" aria-hidden="true">{icon}</span>{title}
      </h3>
      <p class="cta mono">открыть с 1-й главы →</p>
    </div>

    {cover ? (
      <div class="shot" data-focus-frame>
        <Image src={cover} alt={coverAlt ?? ''} widths={[480, 768, 1024]}
               sizes="(min-width: 64rem) 22rem, 90vw" loading="lazy" />
      </div>
    ) : (
      <div class="shot shot--empty" aria-hidden="true"><span class="mono">кадр не выбран</span></div>
    )}

    <p class="desc">{description}</p>
    {episodes !== undefined && (
      <p class="count mono">{episodes} {episodes === 1 ? 'глава' : episodes < 5 ? 'главы' : 'глав'}</p>
    )}
  </a>
</article>

<style>
  .card { position: relative; }
  .link { display: block; color: inherit; text-decoration: none; }

  .head { margin-bottom: .75rem; }
  .title { margin: 0; display: flex; align-items: baseline; gap: .5rem; }
  .icon { font-size: .8em; }

  .cta {
    margin-top: .4rem;
    color: var(--accent);
    opacity: 0; transform: translateY(.4rem);
    transition: opacity var(--t-fast), transform var(--t-fast);
  }

  .shot {
    position: relative; overflow: hidden; isolation: isolate;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
  }
  .shot :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(100%); opacity: .85;
    transition: filter var(--t-color) ease, opacity var(--t-color) ease, transform var(--t-color) ease;
  }
  .shot::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(120% 90% at 50% 40%, rgba(232,163,61,.18), transparent 70%);
    mix-blend-mode: soft-light; opacity: 0;
    transition: opacity var(--t-color) ease;
  }
  .shot.in-focus :global(img) { filter: grayscale(0%); opacity: 1; }
  .shot.in-focus::after { opacity: 1; }

  .shot--empty {
    display: grid; place-items: center;
    border: 1px dashed currentColor; opacity: .3;
  }

  .desc { margin-top: .75rem; line-height: 1.5; font-size: var(--fs-sm); opacity: .75; }
  .count { margin-top: .4rem; opacity: .45; }

  @media (hover: hover) and (pointer: fine) {
    .link:hover .cta { opacity: 1; transform: translateY(0); }
    .link:hover .shot :global(img) { filter: grayscale(0%); opacity: 1; transform: scale(1.02); }
    .link:hover .shot::after { opacity: 1; }
  }

  /* Появление карточек при прокрутке. */
  .card[data-fade-up] { opacity: 0; transform: translateY(2rem);
    transition: opacity 1s ease, transform 1s ease; }
  .card[data-fade-up].fade-up { opacity: 1; transform: translateY(0); }
</style>
