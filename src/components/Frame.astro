---
/**
 * Фотокадр с проявлением цвета.
 *
 * Вне фокуса внимания кадр монохромный и чуть приглушённый — интерфейс
 * остаётся невидимой рамкой, цвет не растаскивает взгляд по странице.
 * В фокусе за 0.4 секунды наливается цветом и тёплым вольфрамовым светом.
 *
 * Что считается фокусом:
 *   мышь есть     — наведение курсора
 *   мыши нет      — въезд в среднюю треть экрана, класс .in-focus от наблюдателя
 *
 * Привязка к наличию мыши, а не к ширине экрана: планшет с сенсором бывает
 * шире ноутбука, и при старой формулировке кадры на нём не проявлялись бы
 * никогда (ТЗ 2.5.2).
 *
 * Спецификация: 01_Spec/tz-paceofhoney-v2.md, раздел 2.5.4
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Ведущий кадр страницы грузится сразу, остальные — по мере прокрутки. */
  eager?: boolean;
  ratio?: string;
}

const { src, alt, caption, eager = false, ratio } = Astro.props;

/*
 * Вертикальный кадр ставится в колонку уже — как портрет в журнале.
 *
 * Иначе обложка 3:4 на ширине текстовой колонки даёт высоту больше экрана:
 * читатель открывает главу и упирается в стену изображения, не видя ни
 * строчки текста. Обрезать вертикаль по горизонтали тоже нельзя — её сняли
 * вертикальной намеренно.
 *
 * Пропорции берём из самого файла: Astro читает их на сборке, гадать
 * не приходится.
 */
const portrait = !ratio && src.height > src.width;
---

<figure class="frame">
  <div
    class:list={['shot', portrait && 'shot--portrait']}
    data-focus-frame
    style={ratio ? `aspect-ratio:${ratio}` : undefined}
  >
    <Image
      src={src}
      alt={alt}
      widths={portrait ? [420, 640, 840] : [640, 960, 1280, 1920]}
      sizes={portrait ? '(min-width: 34rem) 26rem, 100vw' : '(min-width: 64rem) 60rem, 100vw'}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </div>
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>

<style>
  .frame { margin: 0; }

  /* Только геометрия. Проявление цвета и тёплый свет — общие правила
     [data-focus-frame] в tokens.css, чтобы не расходились по копиям. */
  .shot {
    overflow: hidden;
    border-radius: var(--radius);
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
    Узкая колонка для портрета. Не обрезка, а другая ширина: кадр остаётся
    целым, а текст под ним начинается на том же экране, а не за его краем.
  */
  .shot--portrait { width: min(100%, 26rem); margin-inline: auto; }
  .shot--portrait :global(img) {
    height: auto;
    /* Страховка на случай очень длинного кадра — скриншота, например. */
    max-height: min(80vh, 34rem);
    object-fit: contain;
  }

  figcaption { margin-top: .6rem; opacity: .5; }
</style>
