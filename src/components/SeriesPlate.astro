---
/**
 * Верхняя плашка-ориентир: «📖 Сериал «…» · Глава N из M».
 *
 * Её задача — за полсекунды объяснить читателю, куда он попал. Половина
 * приходит из поиска и мессенджеров прямо на восьмую главу, без всякого
 * контекста (ТЗ 3.1.А).
 *
 * Живёт второй строкой внутри общей шапки, а не отдельным фиксированным
 * элементом: два независимых `position: fixed` и создают то наложение,
 * которого просило избежать ТЗ.
 *
 * Серию плашка не выбирает — её приносит нить чтения, известная из адреса
 * страницы. Раньше здесь стоял скрипт, переписывавший плашку в браузере:
 * сервер не знал, какой серией идёт читатель, и рисовал наугад. Теперь
 * знает, и скрипт не нужен.
 */

import type { Series } from '../lib/content';

interface Props {
  series: Series;
  number: number;
  total: number;
  /** Адрес первой главы нити. Пусто, если читатель и так в начале. */
  firstHref?: string;
  /** Соседи текущей главы. Пусто — стрелка гаснет, но остаётся на месте. */
  prevHref?: string;
  nextHref?: string;
}

const { series, number, total, firstHref, prevHref, nextHref } = Astro.props;
const s = series.data;
---

<div class="plate mono" data-plate>
  <p class="where">
    <span aria-hidden="true">{s.icon}</span>
    <span class="name">Журнал «{s.title}»</span>
    <span class="sep" aria-hidden="true">·</span>
    <span data-plate-count>Статья {number} из {total}</span>
  </p>

  <p class="steps">
    <a
      class="step"
      data-step="prev"
      href={prevHref || undefined}
      aria-label="Предыдущая статья"
      aria-disabled={prevHref ? undefined : 'true'}
    >
      <span class="tri" aria-hidden="true">&#9664;</span>
      <span class="word">назад</span>
    </a>
    <a
      class="step"
      data-step="next"
      href={nextHref || undefined}
      aria-label="Следующая статья"
      aria-disabled={nextHref ? undefined : 'true'}
    >
      <span class="word">вперёд</span>
      <span class="tri" aria-hidden="true">&#9654;</span>
    </a>
  </p>

  <p class="ways">
    {firstHref && <a class="first" href={firstHref}>01: начать с 1-й статьи</a>}
    <a href={`/series/${s.id}`}>📋 все статьи журнала</a>
  </p>
</div>

<style>
  .plate {
    display: flex; flex-wrap: wrap; gap: .35rem 1.5rem;
    align-items: baseline; justify-content: space-between;
    width: clamp(18.5rem, 92%, 80rem);
    margin: 0 auto;
    padding: .55rem 1.25rem .7rem;
    font-size: var(--fs-xs);

    /*
      Шапка объявлена сквозной для кликов, чтобы через пустое место рядом
      с меню можно было попасть в страницу. Правило, возвращающее клики её
      содержимому, живёт в стилях шапки — но плашка приходит из другого
      компонента, а Astro изолирует стили по компонентам, и до неё то
      правило не дотягивается. Возвращаем клики здесь, на месте.
    */
    pointer-events: auto;

    border: 1px solid transparent;
    border-radius: 0 0 var(--radius) var(--radius);
    backdrop-filter: blur(.75rem);
    transition: border-color var(--t-fast), background-color var(--t-fast);
  }

  /*
    Фон нужен всегда, а не только после прокрутки, как у главного меню.
    Меню наверху висит над пустым полем, а плашка — сразу над текстом главы:
    без подложки строки просвечивают сквозь неё и обе становятся нечитаемы.
  */
  :global(html:not(.dark)) .plate { background-color: rgba(249, 250, 251, .88); }
  :global(html.dark)       .plate { background-color: rgba(17, 24, 39, .88); }

  :global(html:not(.dark)) :global(.site-header.scrolled) .plate {
    border-color: rgba(17, 24, 39, .15);
  }
  :global(html.dark) :global(.site-header.scrolled) .plate {
    border-color: rgba(249, 250, 251, .18);
  }

  .where { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem; }
  .name { font-weight: 700; }
  .sep { opacity: .4; }

  /* -----------------------------------------------------------------
     Шаг по главам.

     Зона нажатия намеренно больше значка: сам треугольник мелкий, а палец
     на телефоне — нет. Отрицательные поля возвращают строке её высоту,
     чтобы увеличенная мишень не раздувала плашку.
     ----------------------------------------------------------------- */
  .steps { display: flex; align-items: center; gap: .25rem; margin-left: auto; }

  .step {
    display: inline-flex; align-items: center; gap: .3rem;
    padding: .7rem .6rem;
    margin: -.7rem 0;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius);
  }
  .step:hover .word { text-decoration: underline; text-underline-offset: .2em; }
  .tri { font-size: .8em; line-height: 1; }

  /* Конец нити: стрелка не исчезает, а гаснет. Исчезнувшая сдвинула бы
     соседнюю под палец, уже занесённый над ней. */
  .step[aria-disabled] { opacity: .25; pointer-events: none; }

  .ways { display: flex; flex-wrap: wrap; gap: 1rem; }
  .ways a { color: var(--accent); text-decoration: none; white-space: nowrap; }
  .ways a:hover { text-decoration: underline; text-underline-offset: .2em; }

  /* -----------------------------------------------------------------
     Телефон: две строки слева, крупные треугольники справа.

     До 27.09 здесь всё жалось в одну строку, и стрелка выходила ростом
     с строчную букву — Тимур на живом устройстве попадал в неё не всегда.
     Зона нажатия была большой, но глазу не за что зацепиться: мишень
     размечена пустотой, а видно только значок.

     Теперь плашка — сетка из двух колонок. Слева в две строки то, что
     и так переносилось: название журнала и номер статьи. Справа —
     треугольники ростом в обе строки; высота плашки от этого не растёт,
     потому что вторая строка всё равно была.

     Строка «все статьи журнала» на узком экране по-прежнему скрыта:
     переходы есть в конце статьи, а третья строка съела бы пол-экрана.
     ----------------------------------------------------------------- */
  @media (max-width: 34rem) {
    .ways { display: none; }

    .plate {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: .75rem;
      padding: .5rem 1rem .55rem;
    }

    /* Журнал и номер расходятся по строкам — точка между ними больше
       не нужна и только сбивала бы ритм столбика. */
    .where { flex-direction: column; align-items: flex-start; gap: .1rem; }
    .sep { display: none; }

    .steps { margin-left: 0; gap: .35rem; }

    /* Слово рядом с треугольником вернуло бы плашке третью строку. */
    .word { display: none; }

    .step { padding: .45rem .5rem; margin: 0; }

    /* Рост треугольника — вровень с двумя строками слева.
       `line-height: 1` держит его точно по центру: у символа большой
       внутренний просвет снизу, и без этого он висит выше середины. */
    .tri { font-size: 1.75rem; line-height: 1; }
  }
</style>
