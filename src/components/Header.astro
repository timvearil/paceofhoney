---
/**
 * Верхняя плашка: меню, переключатель темы, шторка на узких экранах.
 *
 * Один фиксированный контейнер с двумя строками. Вторая строка — слот:
 * на страницах эпизодов туда встаёт плашка «Глава N из M», и она не
 * скрывается вместе с меню.
 *
 * Состав меню читается из src/content/settings/menu.md — код трогать не нужно.
 *
 * Спецификация: 01_Spec/tz-paceofhoney-v2.md, разделы 2.6, 4.3
 */

import { getEntry } from 'astro:content';

const menu = await getEntry('menu', 'menu');
const items = menu?.data.items ?? [];

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (url: string) => (url === '/' ? here === '/' : here.startsWith(url));
---

<header id="site-header" class="site-header">
  <div class="row">
    <nav class="pill theme-border" aria-label="Основная навигация">
      <a class="brand mono" href="/">paceofhoney.me</a>

      <ul class="menu mono">
        {items.map((item) => (
          <li>
            <a href={item.url} class:list={['link', { active: isActive(item.url) }]}
               aria-current={isActive(item.url) ? 'page' : undefined}>
              {item.title}
            </a>
          </li>
        ))}
      </ul>

      <div class="tools">
        <button id="themeToggle" type="button" class="icon" aria-label="Переключить тему">
          <span class="theme-hide-dark" aria-hidden="true">☾</span>
          <span class="theme-hide-light" aria-hidden="true">☀</span>
        </button>
        <button id="menuButton" type="button" class="icon burger"
                aria-label="Открыть меню" aria-expanded="false" aria-controls="drawer">
          <span aria-hidden="true"></span>
        </button>
      </div>
    </nav>
  </div>

  <slot name="plate" />
</header>

<div id="drawerOverlay" class="overlay"></div>

<aside id="drawer" class="drawer theme-border" aria-label="Меню" inert>
  <button id="drawerClose" type="button" class="icon close" aria-label="Закрыть меню">
    <span aria-hidden="true">×</span>
  </button>
  <ul class="drawer-menu mono">
    {items.map((item) => (
      <li>
        <a href={item.url} class:list={{ active: isActive(item.url) }}
           aria-current={isActive(item.url) ? 'page' : undefined}>
          {item.title}
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 1000;
    pointer-events: none;   /* сквозь пустое место плашки страница кликается */
    transition: transform var(--t-fast) ease;
  }
  .site-header > * { pointer-events: auto; }

  /* Листаем вперёд — уезжает целиком, вместе с плашкой серии. */
  .site-header.nav-hidden { transform: translateY(-100%); }

  .row { display: flex; justify-content: center; padding: 1rem; }

  .pill {
    display: flex; align-items: center; gap: 1.5rem;
    width: clamp(18.5rem, 92%, 80rem);
    padding: .5rem .75rem;
    border: 1px solid transparent;
    border-radius: 8rem;
    transition: padding var(--t-fast), border-color var(--t-fast), background-color var(--t-fast);
    backdrop-filter: blur(0);
  }

  /* Отъехали от верха — плашка собирается и подкладывает под себя стекло. */
  .site-header.scrolled .pill {
    padding: .45rem 1.25rem;
    backdrop-filter: blur(.75rem);
  }
  :global(html:not(.dark)) .site-header.scrolled .pill {
    border-color: rgba(17, 24, 39, .15);
    background-color: rgba(249, 250, 251, .72);
  }
  :global(html.dark) .site-header.scrolled .pill {
    border-color: rgba(249, 250, 251, .18);
    background-color: rgba(17, 24, 39, .72);
  }

  .brand { font-weight: 700; text-decoration: none; color: inherit; white-space: nowrap; }

  .menu { display: none; list-style: none; gap: 1.25rem; margin: 0 auto 0 1rem; padding: 0; }
  .menu .link { color: inherit; text-decoration: none; opacity: var(--dim); transition: opacity var(--t-fast); }
  .menu .link:hover { opacity: 1; }
  .menu .link.active { opacity: 1; font-weight: 700; }

  .tools { display: flex; align-items: center; gap: .25rem; margin-left: auto; }

  .icon {
    display: grid; place-items: center;
    width: 2rem; height: 2rem;
    background: none; border: none; color: inherit;
    font-size: 1rem; line-height: 1; cursor: pointer;
    transition: transform var(--t-fast);
  }
  .icon:hover { transform: scale(1.12); }

  .burger span,
  .burger span::before,
  .burger span::after {
    display: block; width: 1.1rem; height: 1.5px;
    background: currentColor; content: '';
  }
  .burger span::before { transform: translateY(-5px); }
  .burger span::after  { transform: translateY(3.5px); }

  /* --- Шторка ----------------------------------------------------------- */

  .drawer {
    position: fixed; top: 0; right: -20rem;
    width: min(20rem, 85vw);
    height: 100dvh;           /* не 100vh: иначе прыгает под адресной строкой */
    z-index: 1100;
    display: flex; flex-direction: column; gap: 2rem;
    padding: clamp(4rem, 12vw, 7rem) 2rem 2rem;
    border-left: 1px solid;
    transition: right var(--t-fast) ease;
  }
  :global(html:not(.dark)) .drawer { background: var(--light); }
  :global(html.dark)       .drawer { background: var(--dark); }
  .drawer.open { right: 0; }

  .close { position: absolute; top: 1.25rem; right: 1.25rem; font-size: 1.5rem; }

  .drawer-menu { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .drawer-menu a { color: inherit; text-decoration: none; opacity: var(--dim); font-size: var(--fs-sm); }
  .drawer-menu a.active { opacity: 1; font-weight: 700; }

  .overlay {
    position: fixed; inset: 0; z-index: 1050;
    background: rgba(17, 24, 39, .4);
    backdrop-filter: blur(2px);
    opacity: 0; pointer-events: none;
    transition: opacity var(--t-fast);
  }
  .overlay.show { opacity: 1; pointer-events: auto; }

  /* Меню в строку помещается начиная с планшета; ниже — только шторка. */
  @media (min-width: 768px) {
    .menu { display: flex; }
    .burger { display: none; }
    .drawer { display: none; }
  }
</style>
